# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/panditji?retryWrites=true&w=majority

# JWT secret — generate a strong random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Server port (default: 5001)
PORT=5001

# Node environment
NODE_ENV=development

# CORS origin — the frontend URL
CORS_ORIGIN=http://localhost:5173

# Google Gemini API key (optional — for AI chat feature)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
